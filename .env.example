# Shared
DATABASE_URL=sqlite:///bottrap.db

# LLM
LLM_PROVIDER=groq
LLM_API_KEY=your_key_here
LLM_MODEL=
LLM_MAX_PER_MIN=20

# API
ALLOWED_ORIGIN=http://localhost:5173
API_PORT=5001
RUN_WORKER=true

# Honeypot
HONEYPOT_PORT=5000

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:5001

#HONEYTRAP
HONEY_TOKEN_PREFIX=bt_live_
HONEY_TOKEN_TTL_HOURS=24
HONEY_TOKEN_MAX_PER_IP_HOUR=20

AUTO_APPROVE_RULES=false
DYNAMIC_RULES_REFRESH_SECONDS=10
